    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "scripts": {
        "sources:sync": "node scripts/sources-sync.ts",
        "prepare:site": "node scripts/prepare-site.ts",
        "dev": "node scripts/prepare-site.ts && next dev",
        "build": "node scripts/prepare-site.ts && next build",
        "format": "biome format --write",
        "lint": "biome lint",
        "check": "biome check",
        "check:fix": "biome check --write",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "fumadocs-core": "16.14.5",
        "fumadocs-mdx": "15.3.0",
        "fumadocs-ui": "16.14.5",
        "next": "16.3.3",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@tailwindcss/postcss": "4.3.3",
        "@types/mdx": "2.0.14",
        "@types/node": "26.3.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2"
    }
}

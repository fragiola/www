{
    "name": "www",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "scripts": {
        "sources:sync": "node scripts/sources-sync.ts",
        "sources:fixtures": "node scripts/sources-fixtures.ts",
        "prepare:site": "node scripts/prepare-site.ts",
        "registry:copy": "node scripts/registry-copy.ts",
        "brand:icons": "node scripts/brand-icons.ts",
        "dev": "node scripts/dev.ts",
        "build": "node scripts/build.ts",
        "serve": "node scripts/serve.ts",
        "measure": "node scripts/measure.ts",
        "test": "vitest run",
        "e2e:build": "node scripts/sources-fixtures.ts && node scripts/build.ts --fixtures",
        "e2e": "playwright test",
        "format": "biome format --write",
        "lint": "biome lint",
        "check": "biome check",
        "check:fix": "biome check --write",
        "typecheck": "fumadocs-mdx && tsc --noEmit",
        "e2e:serve": "WWW_E2E_SERVER=serve playwright test"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@mdx-js/mdx": "3.1.1",
        "clsx": "2.1.1",
        "fumadocs-core": "16.14.5",
        "fumadocs-mdx": "15.3.0",
        "fumadocs-ui": "16.14.5",
        "github-slugger": "2.0.0",
        "lucide-react": "1.47.0",
        "mdast-util-to-string": "4.0.0",
        "next": "16.3.3",
        "next-themes": "0.4.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-resizable-panels": "4.13.3",
        "remark-gfm": "4.0.1",
        "shiki": "4.4.3",
        "tailwind-merge": "3.6.0",
        "tailwind-variants": "3.3.1",
        "three": "0.186.0",
        "unist-util-visit": "5.1.0",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.3.3",
        "@types/estree": "1.0.9",
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "@types/mdx": "2.0.14",
        "@types/node": "26.3.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@types/three": "0.186.0",
        "mdast-util-mdx": "3.0.0",
        "mdast-util-mdx-jsx": "3.2.0",
        "serve": "14.2.6",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2",
        "vitest": "4.1.11"
    }
}
